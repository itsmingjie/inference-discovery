{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:inference-discovery:descriptor:1",
  "title": "Inference Discovery descriptor version 1",
  "type": "object",
  "required": [
    "version",
    "name",
    "api",
    "auth"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "name": {
      "$ref": "#/$defs/text",
      "maxLength": 128
    },
    "api": {
      "type": "object",
      "required": [
        "base_url",
        "profiles",
        "capabilities",
        "models"
      ],
      "properties": {
        "base_url": {
          "type": "string",
          "maxLength": 2048,
          "pattern": "^https?://[^/@?#\\\\\\s]+(?:/[^?#\\\\\\s]*)?$"
        },
        "profiles": {
          "$ref": "#/$defs/tokens",
          "minItems": 1
        },
        "capabilities": {
          "$ref": "#/$defs/tokens"
        },
        "default_model": {
          "$ref": "#/$defs/text",
          "maxLength": 256
        },
        "models": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": {
            "$ref": "#/$defs/model"
          }
        }
      },
      "additionalProperties": true
    },
    "auth": {
      "type": "object",
      "required": [
        "methods"
      ],
      "properties": {
        "methods": {
          "$ref": "#/$defs/tokens",
          "minItems": 1
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true,
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
    },
    "tokens": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]{0,63}$"
      }
    },
    "model": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/text",
          "maxLength": 256
        },
        "name": {
          "$ref": "#/$defs/text",
          "maxLength": 128
        },
        "reasoning": {
          "type": "boolean"
        },
        "reasoning_efforts": {
          "$ref": "#/$defs/tokens",
          "minItems": 1
        },
        "context_window": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "max_output_tokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        }
      },
      "dependentSchemas": {
        "reasoning_efforts": {
          "required": [
            "reasoning"
          ],
          "properties": {
            "reasoning": {
              "const": true
            }
          }
        }
      },
      "additionalProperties": true
    }
  }
}
